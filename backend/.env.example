# SECRET_KEY es obligatoria — no tiene valor por default (AGENTS.md, RNF-05).
# Generar una clave propia, ej.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ruta del archivo SQLite (no versionado, se crea vacío en el primer arranque)
DATABASE_URL=sqlite:///./dyp_lasercore.db

# Origen permitido para CORS (frontend Angular en desarrollo)
CORS_ORIGINS=http://localhost:4200
